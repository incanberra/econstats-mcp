# Local development defaults to stdio (no HTTP port). Never commit a real .env.
# Hosted settings and OAuth setup: docs/northflank.md

# FRED_API_KEY=
# BLS_API_KEY=
# BEA_API_KEY=
# EIA_API_KEY=
# COMTRADE_API_KEY=

# Hosted HTTP (Docker sets PORT, MCP_HOST and NODE_ENV):
# MCP_AUTH_MODE=oauth
# MCP_PUBLIC_URL=https://YOUR-SERVICE.code.run/mcp
# MCP_OAUTH_ISSUER=https://YOUR-IDENTITY-PROVIDER/
# MCP_OAUTH_JWKS_URL=https://YOUR-IDENTITY-PROVIDER/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://YOUR-SERVICE.code.run/mcp
# MCP_OAUTH_SCOPE=econstats:read
# MCP_OAUTH_SUBJECTS=YOUR-IDENTITY-PROVIDER-USER-ID

# Alternative for clients with custom Authorization headers (not ChatGPT OAuth):
# MCP_AUTH_MODE=bearer
# MCP_AUTH_TOKEN=GENERATE-A-RANDOM-SECRET-DO-NOT-USE-THIS-EXAMPLE

# Optional, exact browser origins only; server-to-server clients do not need CORS.
# MCP_ALLOWED_ORIGINS=https://YOUR-WEB-APP.example
# MCP_MAX_CONCURRENT=16

# The hosted image defaults to memory-only caches/history for a no-volume start.
# For durable history, mount a writable volume and use BOTH settings:
# ECONSTATS_DISK_CACHE=true
# ECONSTATS_CACHE_DIR=/data/econstats
# PREFETCH_HOT_SERIES=false
