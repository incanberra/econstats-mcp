{
  "name": "econstats-mcp",
  "version": "2.6.0",
  "description": "Economic data MCP server — FRED, BLS, BEA, IMF, OECD, Eurostat, BIS, EIA, World Bank, ECB with verified source selection",
  "type": "module",
  "bin": {
    "econstats-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test"
  },
  "keywords": [
    "mcp",
    "economics",
    "fred",
    "bls",
    "bea",
    "imf",
    "oecd",
    "eurostat",
    "bis",
    "eia",
    "world-bank",
    "ecb",
    "inflation",
    "economic-data",
    "claude",
    "openbb",
    "model-context-protocol"
  ],
  "author": "Josh Waldman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/incanberra/econstats-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@upstash/redis": "^1.37.0",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "i18n-iso-countries": "^7.14.0",
    "zod": "^4.3.6"
  }
}
