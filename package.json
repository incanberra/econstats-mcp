{
  "name": "econstats-mcp",
  "version": "3.3.0",
  "description": "Economic data MCP server with PortWatch, FAOSTAT, structured observations and revision tracking",
  "type": "module",
  "bin": {
    "econstats-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:hosted": "bun run scripts/check-hosted.ts",
    "build:faostat": "bun run scripts/build-faostat.ts --output faostat-data"
  },
  "keywords": [
    "mcp",
    "economics",
    "fred",
    "bls",
    "bea",
    "imf",
    "oecd",
    "eurostat",
    "bis",
    "eia",
    "abs",
    "comtrade",
    "world-bank",
    "ecb",
    "inflation",
    "economic-data",
    "claude",
    "openbb",
    "model-context-protocol"
  ],
  "author": "Josh Waldman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/incanberra/econstats-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@upstash/redis": "^1.37.0",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "i18n-iso-countries": "^7.14.0",
    "jose": "^6.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
